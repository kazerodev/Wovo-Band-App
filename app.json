{
  "expo": {
    "name": "Kinora",
    "slug": "kinora",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "kinora",
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "backgroundColor": "#080810",
      "resizeMode": "contain"
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.kazerodev.kinora"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#080810"
      },
      "package": "com.kazerodev.kinora",
      "versionCode": 1,
      "permissions": []
    },
    "plugins": [
      "expo-router",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
