{
  "expo": {
    "name": "Wovo Band",
    "slug": "wovo-band-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "wovoband",
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "backgroundColor": "#080810",
      "resizeMode": "contain"
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.wovoband.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#080810"
      },
      "package": "com.wovoband.app",
      "versionCode": 1
    },
    "plugins": [
      "expo-router",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
